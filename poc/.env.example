# Copy to .env (git-ignored by the repo's root .gitignore). Sandbox and devnet values only.

# Sumsub sandbox app token and secret (Dashboard > Dev space > App tokens, sandbox mode)
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=basic-kyc-level
# Secret configured on the Sumsub webhook (Dev space > Webhooks)
SUMSUB_WEBHOOK_SECRET=

# Didit sandbox API key, workflow id and webhook secret (Business console > API & Webhooks)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# Devnet only. Path to a funded devnet keypair JSON; when empty the SAS flow generates one and airdrops.
SAS_PAYER_KEYPAIR=
SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# Mainnet RPC for read-only SNS lookups
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Etherfuse sandbox (CETES onramp PoC). Create the sandbox business org and key yourself; sandbox KYB is self-approved.
ETHERFUSE_SANDBOX_API_KEY=
ETHERFUSE_ORG_ID=
ETHERFUSE_WALLET=
ETHERFUSE_CLABE=012180000000000002
