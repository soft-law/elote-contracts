{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "cargo test -p elote_pool",
    "idl:sync": "cp target/idl/elote_pool.json idl/elote_pool.json",
    "codama": "npm run idl:sync && node codama.mjs",
    "build:client": "npm --prefix clients/js run build",
    "demo": "tsx scripts/demo-pool.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "check:client": "node codama.mjs && git diff --exit-code --stat clients/js/src/generated clients/js/package.json",
    "test:client": "tsx --test clients/js/test/*.test.ts"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.7.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.5.0",
    "@solana/program-client-core": "^8.5.0",
    "@types/node": "^22.20.5",
    "codama": "^1.11.0",
    "prettier": "^2.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
